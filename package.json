{
  "name": "kindle-ink-portal",
  "version": "0.1.0",
  "description": "Kindle-optimized file browser and content reader with e-ink display support",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "start": "node dist/server.js",
    "lint": "eslint src/ client/",
    "lint:fix": "eslint src/ client/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"client/**/*.ts\" \"views/**/*.njk\" \"public/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"client/**/*.ts\" \"views/**/*.njk\" \"public/**/*.css\"",
    "clean": "rm -rf dist/ public/js/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kindle",
    "e-ink",
    "file-browser",
    "nunjucks",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/nunjucks": "^3.2.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}