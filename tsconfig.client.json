{
  "compilerOptions": {
    "target": "ES5",
    "module": "ES2015",
    "lib": ["ES5", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true
  },
  "include": ["client/**/*.ts"],
  "exclude": ["node_modules"]
}
